*.egg-info/
build/
dist/
.build/
.swiftpm/
.DS_Store

# Windows .NET build products stay local.
/windows/**/bin/
/windows/**/obj/

# Local Codex and planning work is not part of the public project.
.codex/
.superpowers/
artifacts/
docs/superpowers/

# Local downloaded media and metadata should stay out of git.
downloads/
*.log
*.env
*.env.*
!.env.example
.track-downloader-archive.txt
track-downloader-quality-report.txt
*.mp3
*.m4a
*.opus
*.ogg
