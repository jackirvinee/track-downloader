# Keep the deterministic native app icon sources; downloaded artwork remains ignored.
!Track Downloader.app/Contents/Resources/AppIcon-1024.png
!Track Downloader.app/Contents/Resources/AppIcon.iconset/
!Track Downloader.app/Contents/Resources/AppIcon.iconset/*.png
!windows/TrackDownloader.Windows.Package/Assets/
!windows/TrackDownloader.Windows.Package/Assets/*.png

# The app bundle is assembled locally. Keep its source plist and icon assets,
# but never commit generated executables or signatures.
Track Downloader.app/Contents/MacOS/
Track Downloader.app/Contents/_CodeSignature/
