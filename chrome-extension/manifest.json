{
  "manifest_version": 3,
  "name": "Track Downloader Companion",
  "version": "0.2.2",
  "description": "Queue authorized YouTube and SoundCloud pages in Track Downloader.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*"
  ],
  "action": {
    "default_title": "Queue in Track Downloader",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*"
      ],
      "js": ["content-logic.js", "content-script.js"],
      "css": ["content-script.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
