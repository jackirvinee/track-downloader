<Window x:Class="TrackDownloader.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Downloader"
        Width="520"
        Height="290"
        MinWidth="440"
        MinHeight="260"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Track Downloader" />
        <TextBlock Grid.Row="2" Text="Paste a YouTube or SoundCloud HTTPS link" />
        <TextBox x:Name="UrlBox"
                 Grid.Row="4"
                 MinHeight="34"
                 VerticalContentAlignment="Center"
                 Text=""
                 ToolTip="Paste a YouTube or SoundCloud HTTPS link" />
        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="6"
                     Height="6"
                     Minimum="0"
                     Maximum="100"
                     Visibility="Collapsed" />
        <StackPanel Grid.Row="7" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="#505050" Text="Ready for a link." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="DownloadButton"
                        Width="104"
                        Height="32"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        Click="DownloadButton_Click"
                        Content="Download" />
                <Button x:Name="CancelButton"
                        Width="82"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="CancelButton_Click"
                        Content="Cancel"
                        IsEnabled="False" />
                <Button x:Name="ShowFilesButton"
                        Width="100"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="ShowFilesButton_Click"
                        Content="Show files" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
